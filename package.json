{
  "name": "gaeru-independent-store",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone GAERU storefront and administration backed by PostgreSQL",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:local": "node src/local-server.js",
    "owner:setup": "node src/setup-owner.js",
    "db:migrate": "node src/migrate.js",
    "db:seed": "node src/seed.js",
    "admin:hash-password": "node src/hash-password.js",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "jsqr": "1.4.0",
    "linkedom": "^0.18.14"
  }
}
