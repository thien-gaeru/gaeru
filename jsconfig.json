{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": false,
    "maxNodeModuleJsDepth": 1
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "test/**/*",
    "*.js"
  ],
  "exclude": [
    "node_modules",
    ".audit-screenshots"
  ]
}
