NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://gaeru:replace-this-password@localhost:5432/gaeru_store
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
PGSSL=require
# PGSSL_MIN_VERSION=TLSv1.2 # TLSv1.2 (mặc định, tự động đàm phán lên TLSv1.3 mới nhất) hoặc TLSv1.3 (bắt buộc chuẩn mới)
STORE_ORDERS_ENABLED=false

# Google OAuth (Google Login / One Tap)
# Lấy từ Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Loại: Web application. Authorised JavaScript origins: https://gaeru.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=



# VNPAY is optional. Set all four values to enable online payment.
# Set VNPAY_PAYMENT_URL explicitly to the sandbox or production endpoint issued by VNPAY.
PUBLIC_BASE_URL=https://gaeru.com
# VNPAY_TMN_CODE=ABC12345
# VNPAY_HASH_SECRET=replace-with-merchant-secret
# VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Optional SMTP configuration for one-time customer verification and password-reset links.
# Customer registration, login, and shopping work without SMTP; email requests return
# an explicit configuration error until all SMTP values and the PUBLIC_BASE_URL above are set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=mailer@example.com
# SMTP_PASSWORD=replace-with-mail-provider-secret
# SMTP_FROM=support@gaeru.com

# Optional OpenAI news drafting. Never put the API key in browser code.
# OPENAI_API_KEY=replace-with-server-side-key
# OPENAI_NEWS_MODEL=gpt-4.1-mini

# Cloudflare Turnstile Managed widget for gaeru.com. Set both to enable CAPTCHA after 3 failures.
# TURNSTILE_SITE_KEY=your-public-site-key
# TURNSTILE_SECRET_KEY=your-server-only-secret-key

# Persistent private directory outside the deployment checkout.
# Required for uploads in production; do not use public_html or a build folder.
# MEDIA_ROOT=/absolute/path/to/private-media
